{% extends 'base.html.twig' %}

{% block title %}Portfolio{% endblock %}

{% block body %}

<body data-theme="light">

<!-- ===== NAVBAR ===== -->
{%  include('svg.html.twig') %}
{%  include('navbar.html.twig') %}


<!-- ===== HERO / Présentation ===== -->
<section class="hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6 mb-4">
        <h1 class="display-5 fw-bold">Salut, je m'appelle <span style="color:var(--accent)">Evan</span></h1>
        <p class="lead">Étudiant en <strong>3ᵉ année de BUT Informatique</strong> — parcours <em>RACDV</em>. Passionné par le web, les apps et les animations modernes. Objectif : intégrer une école d'ingénieur.</p>

        <p>Compétences : HTML • CSS • JavaScript • PHP • MySQL • Docker • Java • Android • GLSL/WebGL</p>

        <div class="mt-3">
          <a class="btn btn-primary me-2" href="#projects">Voir mes projets</a>
          <a class="btn btn-outline-primary" href="#repos">Mes dépôts GitHub</a>
        </div>
      </div>

      <div class="col-lg-6 text-center">
        <img src="{{ "img/evan.png" }}" alt="moi" class="avatar">
      </div>
    </div>
  </div>
</section>

<section class="about-section" id="about">
    <div class="about-container">
        <h2 class="about-title">
            <span>Un développeur</span>
            <span class="highlight">curieux</span>
            <span>rigoureux</span>
            <span>et passionné</span>
        </h2>

        <div class="about-line"></div>

        <p class="about-text">
            J’aime comprendre comment les choses fonctionnent en profondeur,
            concevoir des solutions propres et efficaces, et transformer des idées
            en applications concrètes.
            <br /><br />
            Que ce soit en développement web, en backend ou sur des projets plus
            techniques, je travaille avec sérieux, autonomie et une vraie envie
            de progresser en permanence.
        </p>
    </div>
</section>

<section class="interests-section">
    <div class="interests-container">
        <h2 class="interests-title">
            <span>Centres</span> <span>d’intérêts</span>
        </h2>

        <div class="interests-grid">
            <div class="interest-card">
                <span class="icon">💻</span>
                <h3>Développement</h3>
                <p>Création d’applications web modernes, optimisation des performances et exploration de nouvelles technologies.</p>
            </div>

            <div class="interest-card">
                <span class="icon">🎮</span>
                <h3>Gaming & Création</h3>
                <p>Développement de plugins Minecraft, game design et automatisation de systèmes complexes.</p>
            </div>

            <div class="interest-card">
                <span class="icon">🚗</span>
                <h3>Automobile</h3>
                <p>Passion pour les véhicules, la mécanique et les innovations technologiques embarquées.</p>
            </div>

            <div class="interest-card">
                <span class="icon">🎨</span>
                <h3>Design & UI</h3>
                <p>Attention portée aux détails, aux animations et à l’expérience utilisateur.</p>
            </div>

            <div class="interest-card">
                <span class="icon">🚀</span>
                <h3>Innovation</h3>
                <p>Curieux et toujours motivé par les projets ambitieux et les défis techniques.</p>
            </div>
        </div>
    </div>
</section>





<section id="timeline" class="timeline-pin">
    <div class="timeline-screen">

        <!-- GAUCHE : fresque -->
        <div class="timeline-left">
            <h2>Parcours de formation</h2>

            <div class="timeline">
                <div class="timeline-line"></div>
                <div class="timeline-line-progress"></div>
                <div class="tl-item active" data-step="objectif">
                    <div class="dot2"></div>
                    <h5>Objectif : École d'ingénieur</h5>
                </div>

                <div class="tl-item" data-step="but">
                    <div class="dot"></div>
                    <h5>BUT Informatique — RACDV</h5>
                </div>

                <div class="tl-item" data-step="lycee">
                    <div class="dot"></div>
                    <h5>Lycée Dhuoda — STI2D</h5>
                </div>
            </div>
        </div>

        <!-- DROITE : description -->
        <div class="timeline-right">
            <div class="desc-item active" data-desc="objectif">
                <h3>Pourquoi une école d’ingénieur ?</h3>
                <p>
                    Mon objectif est d’intégrer une école d’ingénieur afin d’approfondir mes compétences
                    en <strong>architecture logicielle</strong>, <strong>développement full-stack</strong> et
                    <strong>systèmes complexes</strong>.
                </p>
                <p>
                    J’aime comprendre comment les applications fonctionnent en profondeur :
                    de la conception à la mise en production, en passant par la performance,
                    la sécurité et la scalabilité.
                </p>
                <p>
                    À terme, je souhaite travailler sur des projets à forte valeur technique,
                    où la rigueur, la réflexion et l’innovation ont une vraie importance.
                </p>
            </div>

            <div class="desc-item" data-desc="but">
                <h3>BUT Informatique</h3>
                <p>
                    Actuellement en <strong>3ᵉ année de BUT Informatique</strong>, je me spécialise dans
                    la <strong>conception et le développement d’applications</strong>, avec une forte
                    orientation web.
                </p>
                <p>
                    J’ai travaillé sur de nombreux projets en équipe en utilisant
                    <strong>HTML, CSS, JavaScript, PHP, SQL</strong>, ainsi que des frameworks
                    comme <strong>Symfony et VueJs</strong> et des outils comme <strong>Git / GitLab</strong>.
                </p>
                <p>
                    Ces projets m’ont permis de développer des compétences techniques,
                    mais aussi des méthodes de travail professionnelles :
                    organisation, autonomie, communication et respect des délais.
                </p>
            </div>

            <div class="desc-item" data-desc="lycee">
                <h3>Lycée STI2D</h3>
                <p>
                    Mon intérêt pour l’informatique a réellement commencé en
                    <strong>STI2D</strong>, où j’ai découvert la logique de programmation,
                    les systèmes techniques et la résolution de problèmes.
                </p>
                <p>
                    Cette formation m’a donné une approche concrète et logique,
                    qui m’aide encore aujourd’hui dans ma manière de concevoir
                    des applications et d’aborder des problématiques techniques.
                </p>
                <p>
                    C’est à cette période que j’ai compris que je voulais évoluer
                    dans le domaine du développement et des technologies numériques.
                </p>
            </div>
        </div>

    </div>
</section>







<section id="skills" class="skills-section">
    <div class="skills-pin">

        <h2 class="skills-title">Mes Compétences</h2>

        <div class="skills-track">
            {% set skills = [
                { name: 'PHP', file: 'php.png' },
                { name: 'Symfony', file: 'symfony.svg' },
                { name: 'HTML', file: 'html.png' },
                { name: 'CSS', file: 'css.png' },
                { name: 'JavaScript', file: 'js.png' },
                { name: 'Vue', file: 'VueJs.png' },
                { name: 'Angular', file: 'angular.webp' },
                { name: 'Java', file: 'java.webp' },
                { name: 'Python', file: 'python.png' },
                { name: 'Docker', file: 'docker.png' },
                { name: 'MySQL', file: 'mysql.svg' },
                { name: 'Git', file: 'Git.png' }
            ] %}

            {% for skill in skills %}
                <div class="skill-card">
                    <img
                        src="{{ asset('img/' ~ skill.file) }}"
                        alt="{{ skill.name }}"
                        loading="lazy"
                    >
                    <span>{{ skill.name }}</span>
                </div>
            {% endfor %}
        </div>

    </div>
</section>






<!-- ===== GITHUB REPOS ===== -->
<section id="repos" class="repos-section">
    <div class="repos-wrapper">

        <h2 class="repos-title">Mes dépôts GitHub</h2>

        <!-- SEARCH -->
        <div class="repos-search">
            <input
                type="text"
                id="repoSearch"
                class="form-control"
                placeholder="Rechercher un dépôt (nom, langage, description)…"
            >
        </div>

        <div id="reposGrid" class="row repos-grid">
            <!-- cartes injectées -->
        </div>

    </div>
</section>

<section id="projects-carousel" class="projects-carousel">
    <h2 class="projects-title">Mes projets</h2>

    <div class="row g-4" id="projectsGrid">
        <!-- project cards -->

        <div class="col-md-6 col-lg-4">
            <div class="repo-card p-0">
                <img class="project-img" src="https://ps.w.org/gravatar-enhanced/assets/icon-256x256.png?rev=3133133" alt="Site vitrine">
                <div class="p-3">
                    <h5>Site vitrine — Escape Game</h5>
                    <p class="mb-1">Site responsif présentant un escape game, réalisé avec Bootstrap.</p>
                    <a class="btn btn-sm btn-outline-primary" href="#">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="repo-card p-0">
                <img class="project-img" src="{{ asset('img/spigot.png') }}" alt="Site vitrine">
                <div class="p-3">
                    <h5>Site vitrine — Escape Game</h5>
                    <p class="mb-1">Site responsif présentant un escape game, réalisé avec Bootstrap.</p>
                    <a class="btn btn-sm btn-outline-primary" href="#">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="repo-card p-0">
                <img class="project-img" src="{{ asset("img/lundi_matin_sas_logo.jpeg") }}" alt="Site vitrine">
                <div class="p-3">
                    <h5>Site vitrine — Escape Game</h5>
                    <p class="mb-1">Site responsif présentant un escape game, réalisé avec Bootstrap.</p>
                    <a class="btn btn-sm btn-outline-primary" href="#">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="repo-card p-0">
                <img class="project-img" src="{{ asset('img/etude.jpg') }}" alt="Jeu JavaFX">
                <div class="p-3">
                    <h5>Jeu de trains (Java / JavaFX)</h5>
                    <p class="mb-1">Jeu complet avec gestion des lignes, collisions et IA basique.</p>
                    <a class="btn btn-sm btn-outline-primary" href="#">Voir</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="repo-card p-0">
                <img class="project-img" src="https://iutrs.unistra.fr/websites/iutrs/actus-agenda/2024-2025/ACTU_SITE.jpg" alt="Site vitrine">
                <div class="p-3">
                    <h5>Site vitrine — Escape Game</h5>
                    <p class="mb-1">Site responsif présentant un escape game, réalisé avec Bootstrap.</p>
                    <a class="btn btn-sm btn-outline-primary" href="#">Voir</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="repo-card p-0">
                <img class="project-img" src="https://cdn.1j1ju.com/thumbs/game-lg/medias/41/38/4b-trains-cover.jpeg" alt="Site vitrine">
                <div class="p-3">
                    <h5>Site vitrine — Escape Game</h5>
                    <p class="mb-1">Site responsif présentant un escape game, réalisé avec Bootstrap.</p>
                    <a class="btn btn-sm btn-outline-primary" href="#">Voir</a>
                </div>
            </div>
        </div>




        <!-- add more project cards as needed -->
    </div>

</section>


<!-- CONTACT OVERLAY -->
<div id="contactOverlay" class="contact-overlay"></div>

<!-- CONTACT PANEL -->
{%  include('contact.html.twig') %}




<!-- ===== SETTINGS / PICKER ===== -->
<footer class="bg-transparent">
  <div class="container text-center">
    <p class="mb-0">© <span id="year"></span> Evan N. — Portfolio créé avec HTML, Bootstrap & GSAP</p>
  </div>
</footer>






<script>
    document.getElementById('year').textContent = new Date().getFullYear();
</script>

<script src="{{ asset('js/git.js') }}"></script>
<script src="{{ asset('js/gsap/hero.js') }}"></script>
<script src="{{ asset('js/gsap/about.js') }}"></script>
<script src="{{ asset('js/gsap/interests.js') }}"></script>
<script src="{{ asset('js/gsap/timeline.js') }}"></script>
<script src="{{ asset('js/gsap/skills.js') }}"></script>
<script src="{{ asset('js/gsap/navbar.js') }}"></script>
<script src="{{ asset('js/gsap/contact.js') }}"></script>
<script src="{{ asset('js/gsap/gsap-init.js') }}"></script>



</body>


{% endblock %}
