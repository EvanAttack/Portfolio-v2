{% extends 'base.html.twig' %}

{% block title %}MyAvatar – Projet{% endblock %}

{% block body %}

    <!-- ===== NAVBAR ===== -->
    {%  include('svg.html.twig') %}
    {%  include('navbar.html.twig') %}


    <section class="project-hero">
        <div class="hero-content">
            <span class="project-tag">Projet académique</span>
            <h1>MyAvatar</h1>
            <p>
                MyAvatar est une application web développée en équipe dont l’objectif est de reproduire le fonctionnement du service Gravatar.
            </p>

            <div class="tech-stack">
                <span>Symfony</span>
                <span>Twig</span>
                <span>MySQL</span>
            </div>
        </div>

        <div class="hero-visual">
            <img src="https://ps.w.org/gravatar-enhanced/assets/icon-256x256.png?rev=3133133" alt="MyAvatar preview">
        </div>
    </section>

    <section class="project-section">
        <h2>🎯 Objectif du projet</h2>
        <p>
            L’objectif de <strong>MyAvatar</strong> était de concevoir une application
            permettant à un utilisateur de créer un avatar personnalisé
            (apparence, caractéristiques, identité),
            tout en respectant une architecture logicielle claire et maintenable.
        </p>
    </section>


    </section>

    <section class="about-section" id="about">
        <div class="about-container">
            <h2 class="about-title">
                <span>Objectif du </span>
                <span class="highlight">Projet</span>
            </h2>

            <div class="about-line"></div>

            <p class="about-text">
                L’objectif de <strong>MyAvatar</strong> était de concevoir une application
                permettant à un utilisateur de créer un avatar personnalisé
                (apparence, caractéristiques, identité),
                tout en respectant une architecture logicielle claire et maintenable.

            </p>
        </div>
    </section>

    <section class="interests-section">
        <div class="interests-container">
            <h2 class="interests-title">
                <span>Technologies</span> <span>& Compétences</span>
            </h2>

            <div class="interests-grid">
                <div class="interest-card">
                    <span class="icon">🎨</span>
                    <h3>Interactivité JavaScript</h3>
                    <p>Développement d'animations fluides et d'interactions utilisateur intuitives pour une expérience immersive.</p>
                </div>

                <div class="interest-card">
                    <span class="icon">⚡</span>
                    <h3>Backend Node.js</h3>
                    <p>Gestion performante des données avec un backend léger et efficace pour des temps de réponse optimaux.</p>
                </div>

                <div class="interest-card">
                    <span class="icon">👥</span>
                    <h3>Travail d'Équipe</h3>
                    <p>Collaboration efficace et résolution de problèmes dans un environnement de développement rapide.</p>
                </div>

                <div class="interest-card">
                    <span class="icon">🚀</span>
                    <h3>Innovation</h3>
                    <p>Approche créative combinant sciences marines et anatomie humaine de manière originale.</p>
                </div>
                <div class="interest-card">
                    <span class="icon">⏱️</span>
                    <h3>Performance</h3>
                    <p>Conception et déploiement d'une application complète en temps limité lors de l'événement.</p>
                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

{% endblock %}
